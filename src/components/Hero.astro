---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import ReflowRig from "./ReflowRig.astro";
import { FIVERR_URL } from "../config";
import { PACKAGES } from "../data/pricing";

const from = Math.min(...PACKAGES.map((p) => p.price));
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title">I build beautiful, functional websites that exceed expectations<span class="dot">.</span></h1>
      <p class="lead">
        I'm Rishi Malnad. I design each site around your content and code it by hand, so it loads fast and there's
        no theme to fight with. You order on Fiverr, from ${from}.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href={FIVERR_URL} rel="noopener" target="_blank">
          Order on Fiverr <ArrowUpRight aria-hidden="true" />
        </a>
        <a class="text-link" href="#estimate">or estimate a price first</a>
      </div>
    </div>

    <div class="hero-rig">
      <ReflowRig />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(36px, 6vw, 88px) clamp(56px, 7vw, 96px);
  }

  .hero-grid {
    display: grid;
    gap: clamp(40px, 6vw, 64px);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 22px;
    justify-items: start;
    min-width: 0;
  }

  h1 {
    font-size: clamp(2.5rem, 0.9rem + 3.9vw, 4.75rem);
    font-weight: 800;
    font-stretch: 78%;
    line-height: 0.95;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }

  .dot {
    color: var(--accent);
  }

  .lead {
    max-width: 46ch;
    color: var(--fg-2);
    font-size: var(--t-md);
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 4px;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--fg-2);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 0.3em;
    transition:
      color 0.2s var(--ease),
      text-decoration-color 0.2s var(--ease);
  }

  .text-link:hover {
    color: var(--fg);
    text-decoration-color: var(--accent);
  }

  .hero-rig {
    min-width: 0;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    h1 {
      font-size: clamp(3.25rem, 0.5rem + 7vw, 4.5rem);
      max-width: 14ch;
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: clamp(40px, 4vw, 72px);
    }

    .lead {
      font-size: 1.0625rem;
    }
  }
</style>
