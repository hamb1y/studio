---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";
import { FIVERR_URL } from "../config";

const links = [
  { href: "#work", label: "Work" },
  { href: "#packages", label: "Packages" },
  { href: "#estimate", label: "Estimate" },
  { href: "#process", label: "Process" },
  { href: "#faq", label: "FAQ" },
];
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href="#top" aria-label="studio, home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">studio</span><span class="brand-domain mono" aria-hidden="true">.rishimalnad.dev</span>
    </a>

    <nav class="nav" aria-label="Sections">
      <ul role="list" class="nav-list" id="site-nav">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="bar-end">
      <a class="btn btn--primary btn--sm cta" href={FIVERR_URL} rel="noopener" target="_blank">
        <span>Order on Fiverr</span>
        <ArrowUpRight aria-hidden="true" />
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
        <span class="visually-hidden" data-menu-label>Open menu</span>
        <Menu class="icon-open" aria-hidden="true" />
        <X class="icon-close" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const btn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
  const label = document.querySelector<HTMLElement>("[data-menu-label]");

  if (header && btn && label) {
    const setOpen = (open: boolean) => {
      header.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
      label.textContent = open ? "Close menu" : "Open menu";
    };

    btn.addEventListener("click", () => setOpen(!header.classList.contains("is-open")));
    header.querySelectorAll(".nav-list a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && header.classList.contains("is-open")) {
        setOpen(false);
        btn.focus();
      }
    });

    // A hairline appears under the bar once the page has scrolled.
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    background: rgb(10 11 14 / 0.78);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease);
  }

  .site-header:global(.is-scrolled),
  .site-header:global(.is-open) {
    border-bottom-color: var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    padding-block: 10px;
    gap: 0;
    text-decoration: none;
    margin-right: auto;
    white-space: nowrap;
    min-width: 0;
  }

  .brand-mark {
    align-self: center;
    width: 12px;
    height: 12px;
    margin-right: 10px;
    background: var(--accent);
    border-radius: 2px;
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 800;
    font-stretch: 85%;
    letter-spacing: -0.03em;
  }

  .brand-domain {
    color: var(--fg-3);
    display: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.2vw, 32px);
    margin: 0;
  }

  .nav-list a {
    position: relative;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--fg-2);
    text-decoration: none;
    padding: 8px 0;
    transition: color 0.2s var(--ease);
  }

  .nav-list a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }

  .nav-list a:hover {
    color: var(--fg);
  }

  .nav-list a:hover::after {
    transform: scaleX(1);
  }

  .bar-end {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .menu-btn {
    display: none;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-sm);
    background: transparent;
  }

  .menu-btn svg {
    width: 20px;
    height: 20px;
    grid-area: 1 / 1;
  }

  .menu-btn .icon-close {
    display: none;
  }

  .site-header:global(.is-open) .menu-btn .icon-open {
    display: none;
  }

  .site-header:global(.is-open) .menu-btn .icon-close {
    display: block;
  }

  @media (min-width: 1180px) {
    .brand-domain {
      display: inline;
    }
  }

  /* Below tablet width the links move into a drop-down panel. */
  @media (max-width: 759px) {
    .menu-btn {
      display: grid;
    }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      display: none;
    }

    .site-header:global(.is-open) .nav {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 20px;
    }

    .nav-list a {
      display: block;
      padding: 14px 0;
      font-size: 1.125rem;
      color: var(--fg);
      border-bottom: 1px solid var(--line);
    }

    .nav-list a::after {
      display: none;
    }
  }

  @media (max-width: 759px) {
    .cta {
      min-height: 44px;
    }

    .menu-btn {
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 359px) {
    .cta span {
      display: none;
    }
  }
</style>
