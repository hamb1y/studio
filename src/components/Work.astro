---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { WORK } from "../data/work";

// Screenshots are optional at build time: a case study without files in
// src/assets/work/ renders a plain frame instead of breaking the build.
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/work/*.{png,jpg,jpeg,webp}", { eager: true });
const shot = (id: string, kind: "desktop" | "mobile") => {
  const key = Object.keys(files).find((k) => k.includes(`/${id}-${kind}.`));
  return key ? files[key].default : null;
};
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <header class="sec-head">
      <h2 id="work-title">Recent work</h2>
      <p class="sec-intro">Two sites I built recently. Both are live, so you can click through and try them.</p>
    </header>

    <div class="cases">
      {
        WORK.map((c, index) => {
          const desktop = shot(c.id, "desktop");
          const mobile = shot(c.id, "mobile");
          return (
            <article class:list={["case", { "case--flip": index % 2 === 1 }]} aria-labelledby={`case-${c.id}`}>
              <div class="shots">
                <div class="browser">
                  <div class="chrome" aria-hidden="true">
                    <span class="url mono">{c.domain}</span>
                    {desktop && <span class="scroll-hint mono">hover to scroll</span>}
                  </div>
                  <div class="viewport">
                    {desktop ? (
                      <Image
                        class="shot"
                        src={desktop}
                        alt={`${c.domain} home page on a desktop screen`}
                        widths={[720, 1080, 1440]}
                        sizes="(min-width: 1320px) 760px, (min-width: 1024px) 58vw, 100vw"
                        format="webp"
                        quality={74}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="pending">
                        <span class="mono">{c.domain}</span>
                        <span class="pending-note mono">desktop preview</span>
                      </div>
                    )}
                  </div>
                </div>

                <div class="phone">
                  <div class="phone-screen">
                    {mobile ? (
                      <Image
                        class="shot"
                        src={mobile}
                        alt={`${c.domain} home page on a phone`}
                        widths={[240, 480]}
                        sizes="(min-width: 1024px) 190px, 30vw"
                        format="webp"
                        quality={74}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="pending pending--phone">
                        <span class="pending-note mono">phone</span>
                      </div>
                    )}
                  </div>
                </div>
              </div>

              <div class="case-copy">
                <p class="case-kind">{c.kind}</p>
                <h3 id={`case-${c.id}`}>
                  <a href={c.url} rel="noopener" target="_blank">
                    {c.domain}
                    <ArrowUpRight aria-hidden="true" />
                  </a>
                </h3>
                <p class="case-summary">{c.summary}</p>

                <dl class="built">
                  {c.built.map((b) => (
                    <div>
                      <dt>{b.title}</dt>
                      <dd>{b.detail}</dd>
                    </div>
                  ))}
                </dl>

                <p class="stack">Built with {c.stack}</p>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .cases {
    display: grid;
    gap: clamp(72px, 10vw, 128px);
  }

  .case {
    display: grid;
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
  }

  /* ---------- Frames ---------- */

  .shots {
    position: relative;
    padding: 0 clamp(28px, 9%, 72px) clamp(36px, 6%, 56px) 0;
    min-width: 0;
  }

  .case--flip .shots {
    padding-right: 0;
    padding-left: clamp(28px, 9%, 72px);
  }

  .browser {
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--bg-2);
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.9);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 12px;
    border-bottom: 1px solid var(--line);
  }



  .url {
    flex: 1;
    max-width: 320px;
    margin: 0 auto;
    padding: 5px 10px;
    border-radius: 5px;
    background: var(--bg);
    color: var(--fg-2);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .scroll-hint {
    display: none;
    color: var(--fg-3);
    font-size: 9px;
    white-space: nowrap;
  }

  @media (hover: hover) and (min-width: 640px) {
    .scroll-hint {
      display: block;
    }
  }

  .viewport {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    container-type: inline-size;
    background: var(--bg-1);
  }

  /* On hover the full-page screenshot scrolls from top to bottom. */
  .viewport :global(.shot) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    max-width: none;
    transform: translateY(0);
    transition: transform 1.2s var(--ease-in-out);
  }

  .browser:hover .viewport :global(.shot) {
    transform: translateY(calc(-100% + 62.5cqw));
    transition-duration: 7s;
  }

  .phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(118px, 27%, 196px);
    padding: 6px;
    border: 1px solid var(--line-2);
    border-radius: 26px;
    background: #050608;
    box-shadow:
      0 30px 60px -20px rgb(0 0 0 / 0.95),
      0 0 0 1px rgb(0 0 0 / 0.6);
  }

  .case--flip .phone {
    right: auto;
    left: 0;
  }

  .phone-screen {
    position: relative;
    aspect-ratio: 390 / 844;
    border-radius: 20px;
    overflow: hidden;
    background: var(--bg-1);
  }

  .phone-screen :global(.shot) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .pending {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
    background:
      linear-gradient(to right, rgb(255 255 255 / 0.03) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(to bottom, rgb(255 255 255 / 0.03) 1px, transparent 1px) 0 0 / 32px 32px,
      var(--bg-1);
    color: var(--fg-2);
    text-align: center;
  }

  .pending-note {
    color: var(--fg-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 9px;
  }

  /* ---------- Copy ---------- */

  .case-copy {
    display: grid;
    gap: 18px;
    min-width: 0;
  }

  .case-kind {
    color: var(--fg-3);
    font-size: 0.875rem;
  }

  h3 {
    font-size: var(--t-xl);
    font-weight: 750;
    font-stretch: 82%;
  }

  h3 a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-block: 8px;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  h3 a :global(svg) {
    width: 0.8em;
    height: 0.8em;
    flex: none;
    color: var(--fg-3);
    transition:
      transform 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  h3 a:hover :global(svg) {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  .case-summary {
    color: var(--fg-2);
    font-size: var(--t-md);
    max-width: 52ch;
  }

  .built {
    display: grid;
    gap: 0;
    margin-top: 6px;
    border-top: 1px solid var(--line);
  }

  .built > div {
    display: grid;
    gap: 4px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .built dt {
    font-weight: 650;
    font-size: 0.9875rem;
  }

  .built dd {
    color: var(--fg-2);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .stack {
    color: var(--fg-3);
    font-size: 0.875rem;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .built {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 32px;
    }
  }

  @media (min-width: 1024px) {
    .case {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(40px, 5vw, 80px);
    }

    .case--flip {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .case--flip .shots {
      order: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .browser:hover .viewport :global(.shot) {
      transform: none;
    }
  }
</style>
