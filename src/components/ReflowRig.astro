---
/**
 * The hero motion graphic: a small website that assembles itself from
 * wireframe boxes, then reflows between desktop, tablet and phone widths.
 * The layout inside the frame is real CSS (container queries); the script only
 * changes the frame width, swaps brand themes and smooths breakpoint jumps.
 */
import Monitor from "@lucide/astro/icons/monitor";
import Tablet from "@lucide/astro/icons/tablet";
import Smartphone from "@lucide/astro/icons/smartphone";
import Pause from "@lucide/astro/icons/pause";
import Play from "@lucide/astro/icons/play";
import GripVertical from "@lucide/astro/icons/grip-vertical";
---

<figure class="rig" data-rig aria-labelledby="rig-caption">
  <div class="rig-toolbar">
    <div class="rig-devices" role="group" aria-label="Preview width">
      <button type="button" class="rig-dev" data-device="desktop" aria-pressed="true">
        <Monitor aria-hidden="true" /><span>Desktop</span>
      </button>
      <button type="button" class="rig-dev" data-device="tablet" aria-pressed="false">
        <Tablet aria-hidden="true" /><span>Tablet</span>
      </button>
      <button type="button" class="rig-dev" data-device="phone" aria-pressed="false">
        <Smartphone aria-hidden="true" /><span>Phone</span>
      </button>
    </div>
    <button type="button" class="rig-play" data-play aria-label="Pause animation">
      <Pause class="i-pause" aria-hidden="true" />
      <Play class="i-play" aria-hidden="true" />
    </button>
  </div>

  <div class="rig-stage" data-stage>
    <div class="rig-ruler" aria-hidden="true">
      <span class="rig-bp" data-bp="600" style="--bp: 600"><b>600</b></span>
      <span class="rig-bp" data-bp="900" style="--bp: 900"><b>900</b></span>
      <span class="rig-dim" data-dim><span class="rig-dim-label mono"><span data-readout>1280</span>px</span></span>
    </div>

    <div class="rig-frame" data-frame>
      <div class="rig-chrome" aria-hidden="true">
        <span class="rig-url mono">yourbusiness.com</span>
      </div>
      <div class="rig-screen" data-screen>
        <div class="mock" data-mock data-state="built" data-theme="0" aria-hidden="true">
          <div class="m-page" data-page>
            <div class="m-nav" data-part data-tag="<nav>" style="--i: 0">
              <div class="m-logo"><i></i><b>Your brand</b></div>
              <div class="m-links"><i></i><i></i><i></i><i></i></div>
              <span class="m-btn m-btn--solid m-navcta" data-slot="nav">Call us</span>
              <span class="m-burger"><i></i><i></i><i></i></span>
            </div>

            <div class="m-hero">
              <div class="m-copy" data-part data-tag="<h1> <p>" style="--i: 1">
                <span class="m-kicker"></span>
                <div class="m-h" data-slot="h">Plumbing repairs, same day.</div>
                <div class="m-p"><i></i><i></i><i></i></div>
                <div class="m-ctas">
                  <span class="m-btn m-btn--solid" data-slot="cta1">Get a quote</span>
                  <span class="m-btn m-btn--ghost" data-slot="cta2">Our services</span>
                </div>
              </div>
              <div class="m-art" data-part data-tag="<img>" style="--i: 2">
                <span class="m-sun"></span>
                <span class="m-hill m-hill--back"></span>
                <span class="m-hill m-hill--front"></span>
              </div>
            </div>

            <div class="m-cards">
              <div class="m-card" data-part data-tag=".card" style="--i: 3">
                <span class="m-ico"></span><b></b><p><i></i><i></i></p>
              </div>
              <div class="m-card" data-part data-tag=".card" style="--i: 4">
                <span class="m-ico"></span><b></b><p><i></i><i></i></p>
              </div>
              <div class="m-card" data-part data-tag=".card" style="--i: 5">
                <span class="m-ico"></span><b></b><p><i></i><i></i></p>
              </div>
            </div>

            <div class="m-band" data-part data-tag="<section>" style="--i: 6">
              <div class="m-band-text"><i></i><i></i></div>
              <span class="m-btn m-btn--invert" data-slot="band">Get a quote</span>
            </div>

            <div class="m-foot" data-part data-tag="<footer>" style="--i: 7">
              <i></i><i></i><i></i>
            </div>
          </div>
        </div>
      </div>

      <div
        class="rig-handle"
        data-handle
        role="slider"
        tabindex="0"
        aria-label="Preview width in pixels"
        aria-valuemin="320"
        aria-valuemax="1280"
        aria-valuenow="1280"
        aria-valuetext="1280 pixels"
      >
        <GripVertical aria-hidden="true" />
      </div>
    </div>
  </div>

  <figcaption id="rig-caption" class="rig-caption">
    The page in the frame is real HTML and CSS. Drag the handle to resize it, or pick a device.
  </figcaption>
</figure>

<script>
  type Bucket = "lg" | "md" | "sm";
  interface Step {
    update(dt: number): boolean;
  }

  const rig = document.querySelector<HTMLElement>("[data-rig]");
  if (rig) initRig(rig);

  function initRig(rig: HTMLElement) {
    const stage = rig.querySelector<HTMLElement>("[data-stage]")!;
    const frame = rig.querySelector<HTMLElement>("[data-frame]")!;
    const screen = rig.querySelector<HTMLElement>("[data-screen]")!;
    const mock = rig.querySelector<HTMLElement>("[data-mock]")!;
    const page = rig.querySelector<HTMLElement>("[data-page]")!;
    const handle = rig.querySelector<HTMLElement>("[data-handle]")!;
    const readout = rig.querySelector<HTMLElement>("[data-readout]")!;
    const dim = rig.querySelector<HTMLElement>("[data-dim]")!;
    const playBtn = rig.querySelector<HTMLButtonElement>("[data-play]")!;
    const slots = Object.fromEntries(
      [...rig.querySelectorAll<HTMLElement>("[data-slot]")].map((el) => [el.dataset.slot!, el]),
    );
    const devButtons = [...rig.querySelectorAll<HTMLButtonElement>("[data-device]")];
    const parts = [...mock.querySelectorAll<HTMLElement>("[data-part]")];
    const burger = mock.querySelector<HTMLElement>(".m-burger")!;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    // Three sample businesses, one per brand theme in the CSS.
    const THEMES: Record<string, string>[] = [
      { h: "Plumbing repairs, same day.", cta1: "Get a quote", cta2: "Our services", nav: "Call us", band: "Get a quote" },
      { h: "Fresh bread, baked every morning.", cta1: "Order ahead", cta2: "Today's bakes", nav: "Order", band: "Visit us" },
      { h: "Book a table for tonight.", cta1: "Book a table", cta2: "See the menu", nav: "Book", band: "Book now" },
    ];
    const MIN_W = 320;

    let vmax = 1280; // virtual desktop width
    let scale = 0.5;
    let w = 1280; // current virtual width
    let scroll = 0; // virtual scroll offset inside the mock
    let bucket: Bucket = "lg";
    let theme = 0;
    let playing = !reduceMotion.matches;
    let visible = true;
    let manual: Step | null = null;
    let rafId = 0;
    let last = 0;

    const widthFor = (device: string) => (device === "phone" ? 375 : device === "tablet" ? 820 : vmax);
    const bucketOf = (width: number): Bucket => (width >= 900 ? "lg" : width >= 600 ? "md" : "sm");
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    /* ---------- Geometry ---------- */

    function measure() {
      const stageW = stage.clientWidth;
      vmax = stageW >= 520 ? 1280 : 1024;
      // Leave room for the drag handle on both sides of the centred frame.
      scale = (stageW - 40) / vmax;
      const screenH = Math.round(Math.min(Math.max(stageW * 0.6, 236), 430));
      rig.style.setProperty("--s", String(scale));
      rig.style.setProperty("--screen-h", `${screenH}px`);
      rig.style.setProperty("--vh", String(screenH / scale));
      handle.setAttribute("aria-valuemax", String(vmax));
      if (w > vmax || devButtons[0].getAttribute("aria-pressed") === "true") w = vmax;
      applyWidth(w, false);
      applyScroll(scroll);
    }

    function applyWidth(next: number, animate = true) {
      next = Math.round(Math.min(vmax, Math.max(MIN_W, next)));
      const nextBucket = bucketOf(next);
      const flip = animate && nextBucket !== bucket && !reduceMotion.matches;
      const first = flip ? snapshot() : null;

      w = next;
      rig.style.setProperty("--w", String(w));
      readout.textContent = String(w);
      handle.setAttribute("aria-valuenow", String(w));
      handle.setAttribute("aria-valuetext", `${w} pixels`);

      if (nextBucket !== bucket) {
        bucket = nextBucket;
        mock.dataset.bucket = bucket;
        if (first) playFlip(first);
      }
      dim.classList.toggle("is-narrow", w * scale < 120);
    }

    function applyScroll(y: number) {
      const max = Math.max(0, page.scrollHeight - screen.clientHeight / scale);
      scroll = Math.min(Math.max(0, y), max);
      page.style.transform = `translateY(${-scroll}px)`;
    }

    function maxScroll() {
      return Math.max(0, page.scrollHeight - screen.clientHeight / scale);
    }

    /* ---------- FLIP: smooth the jump when a breakpoint is crossed ---------- */

    function snapshot() {
      return parts.map((el) => el.getBoundingClientRect());
    }

    function playFlip(first: DOMRect[]) {
      parts.forEach((el, i) => {
        const a = first[i];
        const b = el.getBoundingClientRect();
        if (!a.width || !b.width) return;
        const dx = (a.left - b.left) / scale;
        const dy = (a.top - b.top) / scale;
        // Boxes with text only move; plain boxes may also stretch.
        const stretch = el.classList.contains("m-art") || el.classList.contains("m-card");
        const sx = stretch ? a.width / b.width : 1;
        const sy = stretch ? a.height / b.height : 1;
        el.animate(
          [
            { transformOrigin: "0 0", transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})` },
            { transformOrigin: "0 0", transform: "none" },
          ],
          { duration: 620, easing: "cubic-bezier(0.2, 0.8, 0.2, 1)" },
        );
      });
      burger.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 400, easing: "ease-out" });
    }

    /* ---------- Timeline steps ---------- */

    const wait = (ms: number): Step => {
      let t = 0;
      return { update: (dt) => (t += dt) >= ms };
    };

    const tweenWidth = (to: number | (() => number), ms: number): Step => {
      let t = 0;
      let from = -1;
      let target = 0;
      return {
        update(dt) {
          if (from < 0) {
            from = w;
            target = typeof to === "function" ? to() : to;
          }
          t += dt;
          const p = ms <= 0 ? 1 : Math.min(1, t / ms);
          applyWidth(from + (target - from) * ease(p));
          return p >= 1;
        },
      };
    };

    const tweenScroll = (to: "top" | "bottom", ms: number): Step => {
      let t = 0;
      let from = -1;
      let target = 0;
      return {
        update(dt) {
          if (from < 0) {
            from = scroll;
            target = to === "top" ? 0 : maxScroll();
          }
          t += dt;
          const p = ms <= 0 ? 1 : Math.min(1, t / ms);
          applyScroll(from + (target - from) * ease(p));
          return p >= 1;
        },
      };
    };

    const act = (fn: () => void): Step => ({
      update() {
        fn();
        return true;
      },
    });

    const setState = (s: "empty" | "wire" | "built") => act(() => (mock.dataset.state = s));
    const pressDevice = (device: string | null) =>
      act(() => devButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.device === device))));

    function* timeline(): Generator<Step> {
      while (true) {
        yield wait(1600);
        yield pressDevice("tablet");
        yield tweenWidth(820, 1250);
        yield wait(1500);
        yield pressDevice("phone");
        yield tweenWidth(375, 1250);
        yield wait(700);
        yield tweenScroll("bottom", 2200);
        yield wait(700);
        yield tweenScroll("top", 900);
        yield wait(300);
        yield pressDevice("desktop");
        yield tweenWidth(() => vmax, 1300);
        yield wait(1300);
        // Take the page apart and rebuild it in the next brand theme.
        yield setState("empty");
        yield wait(520);
        yield act(() => {
          theme = (theme + 1) % THEMES.length;
          mock.dataset.theme = String(theme);
          Object.entries(THEMES[theme]).forEach(([slot, text]) => {
            if (slots[slot]) slots[slot].textContent = text;
          });
        });
        yield setState("wire");
        yield wait(1500);
        yield setState("built");
        yield wait(900);
      }
    }

    let tl = timeline();
    let current: Step = tl.next().value as Step;

    /* ---------- Frame loop: only runs while something is animating ---------- */

    function frameLoop(now: number) {
      const dt = Math.min(64, now - (last || now));
      last = now;

      if (manual) {
        if (manual.update(dt)) manual = null;
      } else if (playing) {
        if (current.update(dt)) current = tl.next().value as Step;
      }

      if (visible && (playing || manual)) {
        rafId = requestAnimationFrame(frameLoop);
      } else {
        rafId = 0;
      }
    }

    function kick() {
      if (!rafId && visible && (playing || manual)) {
        last = 0;
        rafId = requestAnimationFrame(frameLoop);
      }
    }

    /* ---------- Controls ---------- */

    function setPlaying(next: boolean) {
      playing = next;
      playBtn.setAttribute("aria-label", next ? "Pause animation" : "Play animation");
      rig.classList.toggle("is-paused", !next);
      if (next) {
        // Resume from a clean, fully built desktop view.
        mock.dataset.state = "built";
        tl = timeline();
        current = tl.next().value as Step;
        manual = tweenWidth(() => vmax, reduceMotion.matches ? 0 : 700);
        applyScroll(0);
        devButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.device === "desktop")));
      }
      kick();
    }

    function takeControl() {
      if (playing) setPlaying(false);
      mock.dataset.state = "built";
    }

    devButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        takeControl();
        const device = btn.dataset.device!;
        devButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        applyScroll(0);
        manual = tweenWidth(widthFor(device), reduceMotion.matches ? 0 : 750);
        kick();
      });
    });

    playBtn.addEventListener("click", () => setPlaying(!playing));

    // Drag the handle: the frame is centred, so each side moves by the drag distance.
    let dragStartX = 0;
    let dragStartW = 0;
    handle.addEventListener("pointerdown", (e) => {
      takeControl();
      manual = null;
      dragStartX = e.clientX;
      dragStartW = w;
      handle.setPointerCapture(e.pointerId);
      rig.classList.add("is-dragging");
      devButtons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      applyScroll(0);
    });
    handle.addEventListener("pointermove", (e) => {
      if (!handle.hasPointerCapture(e.pointerId)) return;
      applyWidth(dragStartW + ((e.clientX - dragStartX) * 2) / scale);
    });
    const endDrag = (e: PointerEvent) => {
      if (handle.hasPointerCapture(e.pointerId)) handle.releasePointerCapture(e.pointerId);
      rig.classList.remove("is-dragging");
    };
    handle.addEventListener("pointerup", endDrag);
    handle.addEventListener("pointercancel", endDrag);

    handle.addEventListener("keydown", (e) => {
      const step = e.shiftKey ? 100 : 20;
      let next: number | null = null;
      if (e.key === "ArrowRight" || e.key === "ArrowUp") next = w + step;
      else if (e.key === "ArrowLeft" || e.key === "ArrowDown") next = w - step;
      else if (e.key === "Home") next = MIN_W;
      else if (e.key === "End") next = vmax;
      if (next === null) return;
      e.preventDefault();
      takeControl();
      devButtons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      applyScroll(0);
      applyWidth(next);
    });

    /* ---------- Lifecycle ---------- */

    new ResizeObserver(() => measure()).observe(stage);

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting && !document.hidden;
        kick();
      },
      { threshold: 0.05 },
    ).observe(rig);

    document.addEventListener("visibilitychange", () => {
      visible = !document.hidden;
      kick();
    });

    reduceMotion.addEventListener("change", () => {
      if (reduceMotion.matches) setPlaying(false);
    });

    measure();
    mock.dataset.bucket = bucket;
    setPlaying(playing);
    rig.classList.add("is-ready");
  }
</script>

<style>
  .rig {
    --w: 1280;
    --s: 0.45;
    --screen-h: 380px;
    --wire: var(--accent);
    position: relative;
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  /* ---------- Toolbar ---------- */

  .rig-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .rig-devices {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-1);
  }

  .rig-dev {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 34px;
    padding: 0 12px;
    border: 0;
    border-radius: 5px;
    touch-action: manipulation;
    background: transparent;
    color: var(--fg-2);
    font-size: 0.8125rem;
    font-weight: 500;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .rig-dev svg {
    width: 15px;
    height: 15px;
  }

  .rig-dev:hover {
    color: var(--fg);
  }

  .rig-dev[aria-pressed="true"] {
    background: var(--bg-3);
    color: var(--fg);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .rig-dev[aria-pressed="true"] svg {
    color: var(--accent);
  }



  .rig-play {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    margin-left: auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-1);
    color: var(--fg-2);
  }

  .rig-play:hover {
    color: var(--fg);
    border-color: var(--line-2);
  }

  .rig-play svg {
    width: 15px;
    height: 15px;
    grid-area: 1 / 1;
  }

  .rig-play .i-play,
  .rig:global(.is-paused) .rig-play .i-pause {
    display: none;
  }

  .rig:global(.is-paused) .rig-play .i-play {
    display: block;
  }

  /* ---------- Stage ---------- */

  .rig-stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 18px 0 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.07) 1px, transparent 0) 0 0 / 16px 16px,
      linear-gradient(180deg, var(--bg-1), var(--bg));
    overflow: hidden;
    min-width: 0;
  }

  /* Ruler with breakpoint ticks and a live dimension line. */
  .rig-ruler {
    position: relative;
    width: 100%;
    height: 22px;
  }

  .rig-ruler::before {
    content: "";
    position: absolute;
    left: 16px;
    right: 16px;
    top: 50%;
    height: 1px;
    background: var(--line);
  }

  .rig-bp {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(50% - var(--bp) * var(--s) * 0.5px);
    width: calc(var(--bp) * var(--s) * 1px);
    border-inline: 1px dashed var(--line-2);
  }

  .rig-bp b {
    position: absolute;
    top: -3px;
    right: -1px;
    transform: translateX(50%);
    padding: 0 3px;
    background: var(--bg-1);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 400;
    font-stretch: 87.5%;
    color: var(--fg-3);
    line-height: 1;
  }

  .rig-dim {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(var(--w) * var(--s) * 1px);
    height: 11px;
    transform: translate(-50%, -50%);
    border-inline: 1px solid var(--accent);
    display: grid;
    place-items: center;
  }

  .rig-dim::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--accent);
  }

  .rig-dim-label {
    position: relative;
    padding: 3px 7px;
    border-radius: 3px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* ---------- Browser frame ---------- */

  .rig-frame {
    position: relative;
    width: calc(var(--w) * var(--s) * 1px + 2px);
    max-width: calc(100% - 36px);
    border: 1px solid var(--line-2);
    border-radius: 9px;
    background: var(--bg-2);
    box-shadow:
      0 30px 60px -30px rgb(0 0 0 / 0.8),
      0 0 0 6px rgb(255 255 255 / 0.015);
  }

  .rig-chrome {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 26px;
    padding: 0 9px;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }



  .rig-url {
    flex: 1;
    min-width: 0;
    padding: 3px 4px;
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg-3);
    font-size: 9px;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
  }

  .rig-screen {
    position: relative;
    height: var(--screen-h);
    overflow: hidden;
    border-radius: 0 0 8px 8px;
  }

  .rig-handle {
    position: absolute;
    top: 50%;
    right: -15px;
    display: grid;
    place-items: center;
    width: 14px;
    height: 56px;
    transform: translateY(-50%);
    border: 1px solid var(--line-2);
    border-radius: 5px;
    background: var(--bg-3);
    color: var(--fg-2);
    cursor: ew-resize;
    touch-action: none;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .rig-handle svg {
    width: 12px;
    height: 12px;
  }

  /* A larger invisible hit area around the handle for fingers. */
  .rig-handle::before {
    content: "";
    position: absolute;
    inset: -14px -16px;
  }

  @media (pointer: coarse) {
    .rig-dev {
      min-height: 44px;
      min-width: 44px;
      justify-content: center;
    }

    .rig-play {
      width: 44px;
      height: 44px;
    }

    .rig-handle {
      width: 18px;
      height: 64px;
      right: -19px;
    }
  }

  .rig-handle:hover,
  .rig:global(.is-dragging) .rig-handle {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
