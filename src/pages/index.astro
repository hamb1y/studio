---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Capabilities from "../components/Capabilities.astro";
import Reel from "../components/Reel.astro";
import Work from "../components/Work.astro";
import Packages from "../components/Packages.astro";
import Estimator from "../components/Estimator.astro";
import Process from "../components/Process.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
---

